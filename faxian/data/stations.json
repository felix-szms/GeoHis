      "lat": 34.27,
      "year": 399,
      "leg": "out",
      "major": true,
      "title": "六十五岁出发",
      "note": "同行四人有说有笑地出发，回来的只有他一人",
      "text": "隆安三年，长安经律残缺。65岁的法显与慧景、道整等四人结伴西行，求取戒律——这个年纪，本该在寺里安享晚年。"
    },
    {
      "id": 2,
      "name": "敦煌",
      "modern": "甘肃 · 敦煌",
      "region": "西凉 · 沙州",
      "lng": 94.7,
      "lat": 40.14,
      "year": 400,
      "leg": "out",
      "title": "白龙堆",
      "note": "「上无飞鸟，下无走兽，遍望极目」——《佛国记》原文",
      "text": "敦煌太守李暠供给度沙河。沙河中多有恶鬼热风，遇则皆死。唯以死人枯骨为标识，行十七日，方得渡过。"
    },
    {
      "id": 3,
      "name": "焉夷",
      "modern": "新疆 · 焉耆",
      "region": "西域 · 焉耆",
      "lng": 86.5,
      "lat": 42.06,
      "year": 400,
      "leg": "out",
      "text": "焉夷国僧众皆小乘学，待客冷淡。法显一行不得补给，只好靠苻行堂公孙节粮续行，穿越沙漠再向西南。"
    },
    {
      "id": 4,
      "name": "于阗",
      "modern": "新疆 · 和田",
      "region": "西域 · 于阗",
      "lng": 79.9,
      "lat": 37.1,
      "year": 400,
      "leg": "out",
      "major": true,
      "title": "行像盛会",
      "note": "全国僧数万，家家门前起塔供僧",
      "text": "于阗国丰乐，佛法隆盛。法显驻三月，观看行像大典：轮高丈余的金像庄严入城，王与夫人皆散花焚香。"
    },
    {
      "id": 5,
      "name": "弗楼沙",
      "modern": "巴基斯坦 · 犍陀罗",
      "region": "北天竺 · 犍陀罗",
      "lng": 71.5,
      "lat": 34.6,
      "year": 402,
      "leg": "out",
      "title": "佛钵之国",
      "note": "月氏王曾想搬走佛钵，八万大象与轮船一起抬不动——传说",
      "text": "犍陀罗国供养佛钵之处，僧寺以铜瓶承钵。西行队伍在此分道：三人东还，一人随供养护送。"
    },
    {
      "id": 6,
      "name": "小雪山",
      "modern": "阿富汗 · 中部山地",
      "region": "北天竺 · 小雪山",
      "lng": 69.3,
      "lat": 33.9,
      "year": 402,
      "leg": "out",
      "major": true,
      "title": "痛失同道",
      "note": "慧景口吐白沫，对法显说：我活不成了",
      "text": "翻越小雪山，寒风骤起。慧景冻得口吐白沫，对法显说：我活不成了。法显抚之痛哭：取经大愿未成，你竟先死——仍独自前行。"
    },
    {
      "id": 7,
      "name": "巴连弗邑",
      "modern": "印度 · 巴特那",
      "region": "中天竺 · 华氏城",
      "lng": 85.1,
      "lat": 25.6,
      "year": 404,
      "leg": "out",
      "major": true,
      "title": "天竺求法",
      "art": "assets/art/art-huashi.jpg",
      "note": "道整留下不归了；法显说：我的使命是把经带回汉地",
      "text": "华氏城是天竺佛法中心。法显学梵语、抄经律三年。道整叹此地戒律难得，留而不还；法显独自踏上归途——为了把经带回去。"
    },
    {
      "id": 8,
      "name": "狮子国",
      "modern": "斯里兰卡 · 阿努拉达普拉",
      "region": "狮子国 · 无畏山寺",
      "lng": 80.6,
      "lat": 8.35,
      "year": 410,
      "leg": "ret",
      "major": true,
      "title": "白绢扇",
      "art": "assets/art/art-lion.jpg",
      "note": "故国一物，动了乡愁——他 already 70岁了",
      "text": "在狮子国无畏山寺求得经本两年。一日见商人以晋地白绢扇供佛，不觉凄然泪下：故国一物尚动乡愁，何况身在异域。"
    },
    {
      "id": 9,
      "name": "耶婆提",
      "modern": "苏门答腊 · 巨港",
      "region": "南海 · 耶婆提",
      "lng": 104.7,
      "lat": -2.98,
      "year": 412,
      "leg": "ret",
      "title": "风暴漂流",
      "note": "十三昼夜被风吹离航线——船上的商人以为必死无疑",
      "text": "归途大船遇大风，十三昼夜漂流失向。复九十余日方抵耶婆提，滞留五月换船候风。"
    },
    {
      "id": 10,
      "name": "南海",
      "modern": "粮尽水竭 · 九死一生",
      "region": "东晋 · 海上",
      "lng": 117.0,
      "lat": 12.0,
      "year": 412,
      "leg": "ret",
      "major": true,
      "title": "弃沙门风波",
      "note": "船上二百余人，法显把经卷抱在怀里不动",
      "text": "归途遇黑风暴雨，婆罗门教徒指沙门为不祥，欲弃之入海。法显持经不动，僚属仗义相护。粮水将尽，唯望日月星宿辨向——七十余日后，看见了陆地。"
    },
    {
      "id": 11,
      "name": "崂山",
      "modern": "山东 · 青岛崂山",
      "region": "东晋 · 长广郡",
      "lng": 120.62,
      "lat": 36.15,
      "year": 412,
      "leg": "ret",
      "major": true,
      "title": "陆去海归",
      "note": "上岸第一件事：请人抄写他带回的经卷",
      "text": "412年七月，船抵长广郡牢山南岸。十四年，三十余国，陆去海归。青州刺史迎请安置，法显上岸第一件事：请人抄写经卷。"
    }
