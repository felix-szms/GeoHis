  "stations": [
    {
      "id": 1, "name": "长安", "modern": "陕西 · 西安", "region": "大唐 · 京畿",
      "lng": 108.94, "lat": 34.27, "year": 629,
      "title": "誓愿西行", "major": true, "art": "assets/art/pd-02.jpg",
      "text": "佛法南北纷争，众说难通。玄奘决意孤身西行天竺，求取真经。时朝廷禁出玉门，他在长安潜习梵语，静待时机。"
    },
    {
      "id": 2, "name": "凉州", "modern": "甘肃 · 武威", "region": "大唐 · 陇右",
      "lng": 102.64, "lat": 37.93, "year": 629,
      "title": "禁令如山", "major": true,
      "text": "在凉州开讲《涅槃》，西域商僧闻风毕至。都督李大亮奉旨禁防，勒令东返。慧威法师暗遣二弟子，连夜送他出城。"
    },
    {
      "id": 3, "name": "瓜州", "modern": "甘肃 · 锁阳城", "region": "大唐 · 河西",
      "lng": 96.35, "lat": 40.35, "year": 629,
      "title": "孤旅偷渡", "major": true, "art": "assets/art/pd-03.jpg",
      "text": "刺史独孤达信佛厚待，州吏李昌当殿毁掉访牒。胡人石磐陀受戒为徒，誓送法师过烽燧——他被认为是《西游记》孙悟空的原型之一。"
    },
    {
      "id": 4, "name": "玉门关", "modern": "甘肃 · 瓜州西北", "region": "大唐 · 边关",
      "lng": 95.3, "lat": 40.5, "year": 629,
      "title": "八百流沙", "major": true,
      "tag": "流沙河", "art": "assets/art/pd-01.jpg",
      "text": "只身偷渡玉门关，独入莫贺延碛。八百里流沙，上无飞鸟，下无走兽。四夜五日滴水未进，老马识途，方得野马泉。"
    },
    {
      "id": 5, "name": "伊吾", "modern": "新疆 · 哈密", "region": "西域 · 伊州",
      "lng": 93.51, "lat": 42.83, "year": 629,
      "title": "初入西域",
      "text": "出碛抵伊吾，寺中恰有汉僧三人，相见泪下。高昌使者闻讯，星夜遣人迎请东行。"
    },
    {
      "id": 6, "name": "高昌", "modern": "新疆 · 高昌故城", "region": "西域 · 高昌",
      "lng": 89.52, "lat": 42.88, "year": 630,
      "title": "兄弟之盟", "major": true,
      "tag": "火焰山", "art": "assets/art/pd-06.jpg",
      "text": "高昌王麴文泰苦留不允，几以绝食相逼。终结为兄弟，约归途重会三年，赠金帛、良马与卫队，遣使护送西行。"
    },
    {
      "id": 7, "name": "阿耆尼国", "modern": "新疆 · 焉耆", "region": "西域 · 焉耆",
      "lng": 86.57, "lat": 42.06, "year": 630,
      "title": "孔雀河畔",
      "tag": "高老庄",
      "text": "阿耆尼国四面临山，城依水险。因与高昌结怨，待客冷淡，不给驼马。玄奘停一宿即行，渡孔雀河而西。"
    },
    {
      "id": 8, "name": "屈支国", "modern": "新疆 · 库车", "region": "西域 · 龟兹",
      "lng": 82.97, "lat": 41.72, "year": 630,
      "title": "辩经龟兹", "major": true,
      "tag": "女儿国", "art": "assets/art/pd-07.jpg",
      "text": "龟兹为西域佛国。高僧木叉毱多以《俱舍》诸论相试，玄奘应答如流，反中其疑。留六十余日，观浴佛盛会。"
    },
    {
      "id": 9, "name": "跋禄迦国", "modern": "新疆 · 阿克苏", "region": "西域 · 姑墨",
      "lng": 80.26, "lat": 41.17, "year": 630,
      "title": "姑墨小憩",
      "text": "姑墨国水甘草丰。稍作休整，随即西行，北望天山雪峰连绵不尽。"
    },
    {
      "id": 10, "name": "凌山", "modern": "新疆 · 别迭里山口", "region": "葱岭 · 凌山",
      "lng": 78.95, "lat": 41.0, "year": 630,
      "title": "雪岭生死", "major": true,
      "text": "凌山冰雪千年，春秋含冻。翻越冰达坂七昼夜，徒侣冻死者十之三四，牛马俱绝。下山回望，云雪茫茫。"
    },
    {
      "id": 11, "name": "素叶城", "modern": "吉尔吉斯 · 托克马克", "region": "西突厥 · 素叶",
      "lng": 75.3, "lat": 42.84, "year": 630,
      "title": "碎叶逢猎",
      "text": "出凌山至热海，海水澄湛。素叶城外逢突厥叶护可汗围猎。可汗崇敬法师，留数日，赐绫绢，遣卫队护送西行。"
    },
    {
      "id": 12, "name": "飒秣建国", "modern": "乌兹别克 · 撒马尔罕", "region": "康国 · 撒马尔罕",
      "lng": 66.97, "lat": 39.65, "year": 630,
      "title": "化度胡王", "major": true,
      "text": "撒马尔罕举国事火，不信佛法，二小僧几被猎逐。玄奘为王说法月余，王乃倾心皈依，举国改宗，沙门复业。"
    },
    {
      "id": 13, "name": "铁门", "modern": "乌兹别克 · 拜松峡谷", "region": "石国 · 铁门",
      "lng": 67.1, "lat": 38.55, "year": 630,
      "title": "天险铁门",
      "text": "两壁峭立，色黑如铁。中通一道，设门扉铁铃——出西域以来，天险之最，莫过于此。"
    },
    {
      "id": 14, "name": "梵衍那国", "modern": "阿富汗 · 巴米扬", "region": "吐火罗 · 梵衍那",
      "lng": 67.82, "lat": 34.82, "year": 630,
      "title": "金刚佛影", "major": true,
      "text": "王城东北山崖立石佛，高百五十尺，金色晃曜，宝饰焕烂。玄奘礼佛影窟——传说至诚者，佛影即现。"
    },
    {
      "id": 15, "name": "迦毕试国", "modern": "阿富汗 · 贝格拉姆", "region": "雪山之阴 · 迦毕试",
      "lng": 69.36, "lat": 34.99, "year": 630,
      "title": "雪山法会",
      "text": "雪山之阴的迦毕试国，寺僧久闻法师之名，聚寺论义。玄奘驻留消夏，开讲诸论，声闻雪山。"
    },
    {
      "id": 16, "name": "健驮逻国", "modern": "巴基斯坦 · 白沙瓦", "region": "北印度 · 健驮逻",
      "lng": 71.58, "lat": 34.01, "year": 631,
      "title": "犍陀罗光", "major": true,
      "text": "犍陀罗，佛教艺术之乡。国久罹兵燹，塔寺半荒。玄奘巡礼佛迹，叹正法陵迟，世事无常。"
    },
    {
      "id": 17, "name": "乌仗那国", "modern": "巴基斯坦 · 斯瓦特", "region": "北印度 · 乌苌",
      "lng": 72.36, "lat": 34.77, "year": 631,
      "title": "乌苌礼迹",
      "text": "乌苌全国崇佛，古寺五百。沿印度河上源巡礼圣迹，访阿输迦王所立石塔。"
    },
    {
      "id": 18, "name": "呾叉始罗", "modern": "巴基斯坦 · 塔克西拉", "region": "北印度 · 呾叉始罗",
      "lng": 72.85, "lat": 33.75, "year": 631,
      "title": "残垣听讲",
      "text": "塔克西拉残垣枕山，王城旧基可辨。玄奘从般若跋陀罗咨问诸部疑义，留两月而去。"
    },
    {
      "id": 19, "name": "迦湿弥罗", "modern": "印度 · 斯利那加", "region": "罽宾 · 迦湿弥罗",
      "lng": 74.8, "lat": 34.08, "year": 631,
      "title": "罽宾二载", "major": true,
      "text": "罽宾藏经最富。老法师僧称为其开讲诸论，昼夜无倦。玄奘留滞二年尽得其传，论义挫众外道，声震五印度。"
    },
    {
      "id": 20, "name": "舍卫城", "modern": "印度 · 舍卫城", "region": "中印度 · 舍卫",
      "lng": 82.05, "lat": 27.5, "year": 634,
      "title": "祇园遗芳",
      "text": "祇树给孤独园，佛住世说法二十五年之地。余基千级，故塔尚存，玄奘巡礼经行。"
    },
    {
      "id": 21, "name": "蓝毗尼", "modern": "尼泊尔 · 蓝毗尼", "region": "中印度 · 蓝毗尼",
      "lng": 83.28, "lat": 27.47, "year": 634,
      "title": "无忧石柱",
      "text": "蓝毗尼园，佛诞生处。阿育王石柱岿然独存，铭文犹记无忧王建柱之事。"
    },
    {
      "id": 22, "name": "菩提伽耶", "modern": "印度 · 菩提伽耶", "region": "摩揭陀 · 菩提伽耶",
      "lng": 84.99, "lat": 24.7, "year": 634,
      "title": "菩提树影", "major": true, "art": "assets/art/pd-05.jpg",
      "text": "摩诃菩提寺旁，菩提树围可十余丈，世尊于此证道。玄奘五体投地，悲泪盈目，众僧感恸。"
    },
    {
      "id": 23, "name": "那烂陀", "modern": "印度 · 那烂陀", "region": "摩揭陀 · 那烂陀",
      "lng": 85.44, "lat": 25.14, "year": 634,
      "title": "正法藏所", "major": true,
      "text": "那烂陀寺僧徒数千，经藏如海。寺主戒贤法师年逾百岁，为玄奘重讲《瑜伽师地论》十五月。居此五年，通晓经论五十部。"
    },
    {
      "id": 24, "name": "曲女城", "modern": "印度 · 卡瑙季", "region": "羯若鞠阇 · 曲女城",
      "lng": 79.92, "lat": 27.07, "year": 641,
      "title": "十八日辩", "major": true,
      "text": "戒日王设无遮大会，十八国王、僧俗六千余人云集。玄奘悬《真唯识量》十八日，无人敢破，众尊「大乘天」。"
    },
    {
      "id": 25, "name": "朅盘陀国", "modern": "新疆 · 塔什库尔干", "region": "葱岭 · 朅盘陀",
      "lng": 75.23, "lat": 37.77, "year": 643,
      "title": "重越葱岭",
      "text": "归路重越葱岭。朅盘陀倚山为城，玄奘录「汉日天种」公主堡传说于书。雪隘冰崖，去时经行，归时又过。"
    },
    {
      "id": 26, "name": "疏勒", "modern": "新疆 · 喀什", "region": "佉沙 · 疏勒",
      "lng": 75.99, "lat": 39.47, "year": 643,
      "title": "佉沙驻锡",
      "text": "疏勒为葱岭东麓门户。驻锡数日，整束驮经驼队，东下昆仑北麓。"
    },
    {
      "id": 27, "name": "于阗", "modern": "新疆 · 和田", "region": "于阗 · 和田",
      "lng": 79.92, "lat": 37.11, "year": 644,
      "title": "表奏东归", "major": true,
      "text": "于阗崇佛甲于西域。玄奘滞留七八月，遣使上表太宗，候旨东归。驮经大象溺死河中，经像幸免于难。"
    },
    {
      "id": 28, "name": "长安", "modern": "陕西 · 西安", "region": "大唐 · 京畿",
      "lng": 108.94, "lat": 34.27, "year": 645, "labelOnMap": false,
      "title": "十七年归", "major": true,
      "text": "公元645年正月，玄奘入长安。房玄龄迎于漕上，道俗数十万，香花相接。西行十七年，携经六百五十七部。"
    }
  ],
