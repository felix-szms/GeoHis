  "stations": [
    {
      "id": 1,
      "name": "威尼斯",
      "modern": "意大利 · 威尼斯",
      "region": "威尼斯共和国",
      "lng": 12.34,
      "lat": 45.44,
      "year": 1271,
      "leg": "out",
      "major": true,
      "title": "十七岁启程",
      "art": "assets/art/art-portrait.jpg",
      "note": "父亲和叔叔已经去过一次中国，见到了忽必烈本人",
      "text": "1271年，17岁的马可随父亲尼科洛、叔叔马费奥二次东行。教皇格里高利十世致信蒙古大汗，少年带着圣墓灯油与国书上路。"
    },
    {
      "id": 2,
      "name": "阿卡",
      "modern": "以色列 · 阿卡港",
      "region": "十字军 · 圣地",
      "lng": 32.92,
      "lat": 32.93,
      "year": 1271,
      "leg": "out",
      "title": "圣地带旨",
      "text": "因教皇去世、局势动荡，一行折返阿卡取得新文书与圣墓灯油，再启程东行——这一走，就是十七年。"
    },
    {
      "id": 3,
      "name": "霍尔木兹",
      "modern": "波斯 · 霍尔木兹",
      "region": "伊利汗国 · 波斯",
      "lng": 56.45,
      "lat": 27.15,
      "year": 1271,
      "leg": "out",
      "title": "弃船改陆",
      "note": "他笔下的海船：以椰线缝板、无铁钉，一遇风浪即沉",
      "text": "原拟走海路去中国，见当地海船用椰线缝板、不涂沥青，惧其不固——弃船改走陆路。这个决定，让他多走了上万公里。"
    },
    {
      "id": 4,
      "name": "帕米尔",
      "modern": "塔吉克 · 帕米尔高原",
      "region": "世界屋脊",
      "lng": 74.5,
      "lat": 37.2,
      "year": 1272,
      "leg": "out",
      "major": true,
      "title": "世界屋脊",
      "note": "欧洲人最早记录高原反应的文字，出自《行纪》",
      "text": "翻越帕米尔高原十二日，不见人烟。他记下：火焰因空气稀薄而难燃，颜色也与平原不同——这是欧洲最早的高原反应记录。"
    },
    {
      "id": 5,
      "name": "喀什",
      "modern": "新疆 · 喀什",
      "region": "元 · 西域",
      "lng": 75.99,
      "lat": 39.47,
      "year": 1272,
      "leg": "out",
      "title": "西域绿洲",
      "text": "出高原东行，经喀什、叶尔羌、和阗一线绿洲，商旅重归路上。"
    },
    {
      "id": 6,
      "name": "沙州",
      "modern": "甘肃 · 敦煌",
      "region": "元 · 河西",
      "lng": 94.7,
      "lat": 40.14,
      "year": 1272,
      "leg": "out",
      "title": "千佛洞",
      "text": "沙州敦煌，他记下当地佛寺千龛的盛况——莫高窟在《行纪》中留下了元代的一笔。"
    },
    {
      "id": 7,
      "name": "甘州",
      "modern": "甘肃 · 张掖",
      "region": "元 · 河西",
      "lng": 100.4,
      "lat": 38.93,
      "year": 1273,
      "leg": "out",
      "title": "居留经年",
      "text": "甘州居留近一年，之后原拟北上哈拉和林，因路途遥远作罢，转东南直趋大汗夏宫。"
    },
    {
      "id": 8,
      "name": "上都",
      "modern": "内蒙古 · 元上都",
      "region": "元 · 上都",
      "lng": 116.18,
      "lat": 42.35,
      "year": 1275,
      "leg": "out",
      "major": true,
      "title": "觐见大汗",
      "art": "assets/art/art-kublai.jpg",
      "note": "马可学会了四种语言文字，忽必烈派他奉使各地",
      "text": "1275年抵上都，觐见忽必烈。年轻的马可聪敏谨慎，学会四种语言文字，深得大汗信任，奉使各地长达十七年。"
    },
    {
      "id": 9,
      "name": "杭州",
      "modern": "浙江 · 杭州",
      "region": "元 · 江南",
      "lng": 120.16,
      "lat": 30.25,
      "year": 1285,
      "leg": "ret",
      "major": true,
      "title": "世界最丽之城",
      "note": "他称之为「天城」Quinsai——灵感来自「京师」的发音",
      "text": "行在杭州，他称之「天城」：石桥一万二千座，十倍于威尼斯的街市。欧洲人读到这一章时，没人相信这是真的。"
    },
    {
      "id": 10,
      "name": "泉州",
      "modern": "福建 · 泉州",
      "region": "元 · 刺桐港",
      "lng": 118.6,
      "lat": 24.9,
      "year": 1291,
      "leg": "ret",
      "major": true,
      "title": "刺桐启航",
      "note": "顺便——这也是马可回家的路",
      "text": "1291年，他从泉州护送阔阔真公主海路赴波斯成婚。十四艘大船、六百余人启航——这也是他回家的机会。"
    },
    {
      "id": 11,
      "name": "霍尔木兹",
      "modern": "波斯 · 霍尔木兹",
      "region": "伊利汗国 · 波斯",
      "lng": 56.45,
      "lat": 27.15,
      "year": 1293,
      "leg": "ret",
      "major": true,
      "title": "公主送达",
      "note": "归途才知：忽必烈已于1294年去世",
      "text": "海上二十六月，历尽风暴，随行六百人仅余数人生还。抵达时新郎阿鲁浑汗已死，公主依约改嫁其子。"
    },
    {
      "id": 12,
      "name": "威尼斯",
      "modern": "意大利 · 威尼斯",
      "region": "威尼斯共和国",
      "lng": 12.34,
      "lat": 45.44,
      "year": 1295,
      "leg": "ret",
      "major": true,
      "title": "衣缝藏宝",
      "note": "家人以为他们早已死在远方",
      "text": "1295年，马可回到阔别二十六年的威尼斯，一身褴褛的旅装无人相认。宴席上他撕开旧衣内衬——红宝石、蓝宝石、翡翠滚滚而出。"
    },
    {
      "id": 13,
      "name": "热那亚",
      "modern": "意大利 · 热那亚",
      "region": "狱中 · 1298",
      "lng": 8.93,
      "lat": 44.41,
      "year": 1298,
      "leg": "ret",
      "major": true,
      "title": "百万先生",
      "art": "assets/art/art-milione.jpg",
      "note": "临终之言：「我还没说出所见的一半」",
      "text": "1298年海战被俘入狱，他向同狱作家口述东方见闻，成《马可·波罗行纪》。时人不信，讥称他「百万先生」。临终他答：我还没说出所见的一半。"
    }
